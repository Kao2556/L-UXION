local touchStartPos = nil
local tStartPos = nil
local isDragging = false
local dragThreshold = 6 -- ระยะขยับขั้นต่ำที่จะเริ่มนับเป็นการลาก

ToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        touchStartPos = input.Position
        tStartPos = ToggleBtn.Position
        isDragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if touchStartPos and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - touchStartPos
        if delta.Magnitude > dragThreshold then
            isDragging = true
            ToggleBtn.Position = UDim2.new(tStartPos.X.Scale, tStartPos.X.Offset + delta.X, tStartPos.Y.Scale, tStartPos.Y.Offset + delta.Y)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if not isDragging and touchStartPos then
            -- ถ้าไม่ได้ลาก (เป็นการแตะคลิกปกติ) ให้เปิด-ปิด เมนู
            isOpen = not isOpen
            if isOpen then
                MainFrame.Visible = true
                TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 480, 0, 360)}):Play()
            else
                local tw = TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
                tw:Play()
                tw.Completed:Wait()
                MainFrame.Visible = false
            end
        end
        touchStartPos = nil
        isDragging = false
    end
end)

