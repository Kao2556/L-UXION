getgenv().stopFlyFunc = stopFly

local function startFly()
    stopFly()
    local _, hum, hrp = getChar()
    if not hum or not hrp then return end
    hum.PlatformStand = true
    
    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9000000000, 9000000000, 9000000000)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(9000000000, 9000000000, 9000000000)
    bg.P = 90000
    bg.Parent = hrp

    flyConn = RunService.RenderStepped:Connect(function()
        if not getgenv().scriptRunning then return end
        local _, h, root = getChar()
        if not h or not root then return end
        local cam = Workspace.CurrentCamera
        bg.CFrame = cam.CFrame
        local rel = cam.CFrame:VectorToObjectSpace(h.MoveDirection)
        local dir = cam.CFrame.LookVector * (-rel.Z) + cam.CFrame.RightVector * rel.X
        bv.Velocity = dir * flySpeed
    end)
end

